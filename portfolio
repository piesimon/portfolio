<script>
// Dark mode toggle
function toggleDarkMode(){ document.body.classList.toggle('dark-mode'); }

// Blog posts JSON
const blogPosts = [
  { title: "Why Your Business Needs a Website", desc: "A website increases trust and reach.", full: "A complete explanation of why websites matter for business growth, digital presence, professionalism, and customer reach." },
  { title: "Best IT Practices", desc: "How to protect your business systems.", full: "A complete guide on backups, cybersecurity, maintenance schedules, and safe digital practices." },
  { title: "Power of Good Design", desc: "Brand identity through visuals.", full: "Explains how color, typography, and layout influence branding and customer trust." }
];

// Load blog posts dynamically
const blogContainer = document.getElementById("blog-container");
blogPosts.forEach(p => {
  blogContainer.innerHTML += `
    <div class='col-md-4'>
      <div class='card shadow-sm h-100 p-3'>
        <h5 class='fw-bold'>${p.title}</h5>
        <p>${p.desc}</p>
        <button class='btn btn-primary mt-2' onclick='openPost("${p.title}", "${p.full}")'>Read More</button>
      </div>
    </div>`;
});

// Blog modal function
function openPost(title, content){
  document.getElementById('blogModalTitle').innerText = title;
  document.getElementById('blogModalContent').innerText = content;
  const modal = new bootstrap.Modal(document.getElementById('blogModal'));
  modal.show();
}
</script>

<!-- Bootstrap JS & AOS -->
